{
  "manifest_version": 3,
  "name": "TotTag Helper",
  "version": "0.1.0",
  "description": "Lets the TotTag dashboard find and talk to TotTags over Bluetooth and USB through the TotTag Helper program.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://app.tottag.net/*"
    ]
  },
  "key": ""
}
